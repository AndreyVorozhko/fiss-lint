# ==============================================================================
# Конфигурация навыков для проекта (.skills.env)
# Размещается в корне целевого проекта и коммитится в Git.
# При переходе на другую машину состав навыков сохраняется в репозитории проекта!
# ==============================================================================

# 1. Категории навыков из библиотеки ai-skills (ai-skills/skills/<категория>)
# ------------------------------------------------------------------------------
# Все навыки внутри указанных категорий будут подключены в проект.
# Доступные категории в библиотеке:
#   - common          (общие навыки: compress-natural-language, project-bootstrap и др.)
#   - task-lifecycle  (жизненный цикл задач: постановка, планы, ревью, ADR и др.)
#   - authoring       (написание авторского текста, профили, диагностика ИИ-артефактов)
#   - it              (разработка, безопасность, производительность, git)
#   - for-skills      (мета-навыки: проектирование, ревью и постмортем навыков)
#   - fiss            (навыки для работы со стандартом fiss)
CATEGORIES="
    fiss
"

# 2. Отдельные навыки (из ai-skills или внешние)
# ------------------------------------------------------------------------------
# Поддерживаются различные форматы указания путей:
#   1) Внутренние навыки ai-skills:
#      - Относительно папки skills/:       common/git-commit
#      - Относительно корня ai-skills:     skills/common/git-commit
#      - По имени навыка (автопоиск):      git-commit
#   2) Внешние навыки из базы skills-research (переносимый путь без абсолютных путей!):
#      - Относительно папки repos/:        agentic-awesome-skills/skills/cc-skill-security-review
#      - С префиксом repos/:               repos/agentic-awesome-skills/skills/cc-skill-security-review
#      - По имени навыка (автопоиск):      cc-skill-security-review
#      (Путь к repos настраивается локально в .env ai-skills через RESEARCH_REPOS_DIR)
#   3) Относительно корня этого проекта:   ./custom-skills/my-skill
#   4) Внешний абсолютный путь (legacy):   /path/to/other-repo/skills/custom-skill
SKILLS="
    common/clear-write
    common/git-commit
    it/project-review
    task-lifecycle/adr-maintain
    task-lifecycle/brainstorming
    task-lifecycle/executing-plans
    task-lifecycle/glossary-maintain
    task-lifecycle/human-review-surface
    task-lifecycle/intent-exploration
    task-lifecycle/open-questions-maintain
    task-lifecycle/pre-analysis
    task-lifecycle/project-knowledge-refresh
    task-lifecycle/risk-register
    task-lifecycle/statement-create
    task-lifecycle/subject-knowledge-refresh
    task-lifecycle/writing-plans
    task-lifecycle/hmm-maintain
    for-skills/skill-creator
    agentic-awesome-skills/skills/golang-pro/
    agentic-awesome-skills/skills/improve-codebase-architecture/
    agentic-awesome-skills/skills/software-architecture/
    agentic-awesome-skills/skills/clean-code/
    addyosmani-agent-skills/skills/api-and-interface-design/
    addyosmani-agent-skills/skills/doubt-driven-development/
    superpowers/skills/test-driven-development/
    superpowers/skills/verification-before-completion/
    superpowers/skills/systematic-debugging/
    addyosmani-agent-skills/skills/code-review-and-quality/
    agentic-awesome-skills/skills/review-and-simplify-changes/
    superpowers/skills/receiving-code-review/
"

# 3. Опционально: переопределение целевой директории
# ------------------------------------------------------------------------------
# По умолчанию навыки линкуются в: .agents/skills в корне проекта.
# Можно указать относительный путь от корня проекта или абсолютный путь:
# TARGET_SKILLS_DIR=".agents/skills"
# TARGET_SKILLS_DIR=".opencode/skills"
