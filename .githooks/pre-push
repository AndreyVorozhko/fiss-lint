#!/usr/bin/env bash
set -e

# ==============================================================================
# Git Pre-Push Hook for fiss-lint
# Ensures FISS Principle 6 (Continuous context synchronization) by preventing
# pushes to protected branches (main, master, feature/*, bugfix/*, hotfix/*, fix/*) when FISS synchronization
# state is not 'synchronized'.
# ==============================================================================

HANDOFF_FILE="FISS/state/fiss-handoff.md"
ZERO_OID="0000000000000000000000000000000000000000"

is_protected_branch() {
    local ref="$1"
    case "$ref" in
        refs/heads/main|refs/heads/master|refs/heads/feature/*|refs/heads/bugfix/*|refs/heads/hotfix/*|refs/heads/fix/*)
            return 0
            ;;
        *)
            return 1
            ;;
    esac
}

# Read stdin lines: <local-ref> <local-oid> <remote-ref> <remote-oid>
PROTECTED_PUSH=false
PROTECTED_BRANCH=""

while read -r local_ref local_oid remote_ref remote_oid; do
    # Skip branch deletion
    if [ "$local_oid" = "$ZERO_OID" ] || [ "$local_ref" = "(delete)" ]; then
        continue
    fi

    if is_protected_branch "$remote_ref"; then
        PROTECTED_PUSH=true
        PROTECTED_BRANCH="$remote_ref"
        break
    fi
done

if [ "$PROTECTED_PUSH" = true ]; then
    if [ ! -f "$HANDOFF_FILE" ]; then
        echo "" >&2
        echo "🛑 =================================================================" >&2
        echo "🛑 [FISS PRE-PUSH GATE] Push blocked!" >&2
        echo "🛑 Target branch: ${PROTECTED_BRANCH#refs/heads/}" >&2
        echo "🛑 Reason: Mandatory handoff record '$HANDOFF_FILE' not found." >&2
        echo "🛑 =================================================================" >&2
        echo "" >&2
        exit 1
    fi

    SYNC_STATUS=$(grep -E '^[[:space:]]*fiss synchronization:' "$HANDOFF_FILE" | head -n 1 | sed -E 's/^[[:space:]]*fiss synchronization:[[:space:]]*([a-zA-Z0-9_-]+).*/\1/' | tr '[:upper:]' '[:lower:]')

    if [ "$SYNC_STATUS" != "synchronized" ]; then
        echo "" >&2
        echo "🛑 =================================================================" >&2
        echo "🛑 [FISS PRE-PUSH GATE] Push to protected branch blocked!" >&2
        echo "🛑 Target branch: ${PROTECTED_BRANCH#refs/heads/}" >&2
        echo "🛑 Current FISS synchronization status: '${SYNC_STATUS:-empty}'" >&2
        echo "🛑" >&2
        echo "🛑 According to FISS Principle 6 (Continuous) and project workflow," >&2
        echo "🛑 you must complete Stage 7 (Handoff Gate & Intellectual Space Refresh)" >&2
        echo "🛑 and set:" >&2
        echo "🛑   fiss synchronization: synchronized" >&2
        echo "🛑 in '$HANDOFF_FILE' before pushing to remote." >&2
        echo "🛑 =================================================================" >&2
        echo "" >&2
        exit 1
    fi
fi

exit 0
